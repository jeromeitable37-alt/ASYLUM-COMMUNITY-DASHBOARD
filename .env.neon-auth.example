# ASYLUM Official Dashboard — Neon-only authentication cutover
# Vercel Preview branch: neon-auth-cutover-ready
# NEVER commit live secrets into GitHub.
# For local development copy these key names to your private .env.local.

# PostgreSQL connection from the SAME Neon branch as the Neon Auth URL:
DATABASE_URL=YOUR_BRANCH_SPECIFIC_NEON_CONNECTION_STRING

# Managed Neon Auth on the matching branch; public endpoint safe to expose to browser:
VITE_NEON_AUTH_URL=https://ep-polished-math-ao5yl995.neonauth.c-2.ap-southeast-1.aws.neon.tech/asylum_community/auth
NEON_AUTH_BASE_URL=https://ep-polished-math-ao5yl995.neonauth.c-2.ap-southeast-1.aws.neon.tech/asylum_community/auth
NEON_AUTH_JWKS_URL=https://ep-polished-math-ao5yl995.neonauth.c-2.ap-southeast-1.aws.neon.tech/asylum_community/auth/.well-known/jwks.json

# Enable only after verification settings, migration mapping and isolated preview tests pass.
NEON_AUTH_CUTOVER_ENABLED=false

# Neon Object Storage bucket created in the isolated preview branch:
NEON_STORAGE_BUCKET=asylum-community-images
AWS_ENDPOINT_URL_S3=https://br-shiny-snow-ao71flcj.storage.c-2.ap-southeast-1.aws.neon.tech
AWS_REGION=ap-southeast-1

# Issue a branch-scoped Neon storage:read/write credential.
# Set these secrets ONLY in Vercel branch-specific environment variables:
AWS_ACCESS_KEY_ID=YOUR_PREVIEW_STORAGE_CREDENTIAL_ID
AWS_SECRET_ACCESS_KEY=YOUR_PREVIEW_STORAGE_SECRET

# No SUPABASE_URL, SUPABASE_ANON_KEY or VITE_SUPABASE_* variables
# are used by the Neon cutover branch.
