# Vercel Server Environment Variables — never expose DATABASE_URL in VITE_ variables!
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-POOLED-HOST/asylum_community?sslmode=require
SUPABASE_URL=https://YOUR-EXISTING-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-ANON-KEY
# Email of the original dashboard owner (set privately in Vercel). Used once when initializing a fresh Neon database.
OWNER_EMAIL=owner@example.com

# Vite browser variables (Supabase publishable key is safe for browser use)
VITE_SUPABASE_URL=https://YOUR-EXISTING-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-ANON-KEY
